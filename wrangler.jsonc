// Credentials are Cloudflare Secrets, never source code.
{
  "name": "kr-research-site",
  "workers_dev": false,
  "preview_urls": false,
  "main": "site/analytics/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site-dist",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*", "/api/analytics/events", "/api/article-meta", "/api/article-counts", "/api/shares", "/api/comments"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "rules": [{"type": "Text", "globs": ["**/*.html", "**/*.client.js"], "fallthrough": true}],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "kr-research",
    "database_id": "ec768f39-f7b3-4515-8095-804a6405bc77",
    "migrations_dir": "site/analytics/migrations"
  }],
  "triggers": {"crons": ["5 * * * *"]},
  "secrets": {"required": ["ADMIN_PASSWORD", "ANALYTICS_HMAC_SECRET"]},
  "observability": {"enabled": false}
}
